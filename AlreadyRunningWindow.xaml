<Window x:Class="FSB_helper_C__.AlreadyRunningWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DURAN HELPER" Width="380" Height="180"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Topmost="True" UseLayoutRounding="True" SnapsToDevicePixels="True" TextOptions.TextFormattingMode="Display">
    <Grid Width="360" Height="150" HorizontalAlignment="Center" VerticalAlignment="Center" ClipToBounds="False">
        
        <!-- ============= CLIPPED-CORNER (ASI overlay style) ============= -->
        <!-- Gold accent line: top-left diagonal + horizontal strip -->
        <Path Data="M 0,12 L 12,0 L 150,0" Stroke="{DynamicResource GoldBrush}" StrokeThickness="2"
              HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,0,0,0" IsHitTestVisible="False" Panel.ZIndex="20" />

        <Path Data="M 0,12 L 12,0 L 348,0 L 360,12 L 360,138 L 348,150 L 12,150 L 0,138 Z" Fill="{DynamicResource SidebarBrush}">
            <Path.Effect>
                <DropShadowEffect RenderingBias="Quality" BlurRadius="40" ShadowDepth="15" Opacity="0.9" Color="Black"/>
            </Path.Effect>
        </Path>
        
        <Path Data="M 0,12 L 12,0 L 348,0 L 360,12 L 360,138 L 348,150 L 12,150 L 0,138 Z" 
              Fill="{DynamicResource SidebarBrush}" Stroke="{DynamicResource LineBrush}" StrokeThickness="1.5" />
        
        <Border BorderThickness="0" Background="Transparent">
            <Border.Clip>
                <PathGeometry Figures="M 0,12 L 12,0 L 348,0 L 360,12 L 360,138 L 348,150 L 12,150 L 0,138 Z"/>
            </Border.Clip>
            <Grid>
                <!-- Asymmetrical launcher-style zigzags and accents -->
                <Canvas Opacity="0.35" IsHitTestVisible="False">
                    <Path Data="M -30,130 L 80,40 L 200,90 L 300,15 L 390,60" Stroke="{DynamicResource GoldBrush}" StrokeThickness="1.5" Fill="Transparent"/>
                    <Ellipse Canvas.Left="77" Canvas.Top="37" Width="6" Height="6" Fill="{DynamicResource GoldBrush}"/>
                    <Ellipse Canvas.Left="197" Canvas.Top="87" Width="6" Height="6" Fill="{DynamicResource GoldBrush}"/>
                    <Ellipse Canvas.Left="297" Canvas.Top="12" Width="6" Height="6" Fill="{DynamicResource GoldBrush}"/>
                    
                    <Polyline Points="30,160 50,180 30,200" Stroke="{DynamicResource GoldBrush}" StrokeThickness="2" Opacity="0.5" Fill="Transparent"/>
                    <Line X1="280" Y1="160" X2="300" Y2="180" Stroke="{DynamicResource GoldBrush}" StrokeThickness="2" Opacity="0.5"/>
                    <Line X1="280" Y1="180" X2="300" Y2="160" Stroke="{DynamicResource GoldBrush}" StrokeThickness="2" Opacity="0.5"/>
                    
                    <Ellipse Canvas.Left="200" Canvas.Top="70" Width="100" Height="100" Stroke="{DynamicResource GoldBrush}" StrokeThickness="1" Fill="Transparent" Opacity="0.1"/>
                    
                    <!-- Crossed lines bottom-left -->
                    <Line X1="15" Y1="195" X2="60" Y2="225" Stroke="{DynamicResource GoldBrush}" StrokeThickness="1.5" Opacity="0.5"/>
                    <Line X1="60" Y1="195" X2="15" Y2="225" Stroke="{DynamicResource GoldBrush}" StrokeThickness="1.5" Opacity="0.5"/>
                </Canvas>
                
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="СИСТЕМА УЖЕ АКТИВНА" FontFamily="Segoe UI" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextBrush}" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                    
                    <TextBlock Text="Программа DURAN HELPER уже запущена." FontFamily="Segoe UI" FontSize="12" Foreground="{DynamicResource GrayBrush}" HorizontalAlignment="Center" Margin="0,0,0,2"/>
                    <TextBlock Text="Проверьте системный трей (возле часов)." FontFamily="Segoe UI" FontSize="12" Foreground="{DynamicResource GrayBrush}" HorizontalAlignment="Center" Margin="0,0,0,16"/>

                    <Button Content="ЗАКРЫТЬ" Width="140" Height="36" Cursor="Hand" Click="Close_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="bd" Background="{DynamicResource SideBrush}" BorderBrush="{DynamicResource GoldBrush}" BorderThickness="1" CornerRadius="6">
                                    <Grid>
                                        <Border x:Name="HoverOverlay" Background="White" Opacity="0" CornerRadius="6"/>
                                        <TextBlock Text="{TemplateBinding Content}" Foreground="{DynamicResource GoldBrush}" FontFamily="Segoe UI" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="HoverOverlay" Property="Opacity" Value="0.05"/>
                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter TargetName="HoverOverlay" Property="Opacity" Value="0.1"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>

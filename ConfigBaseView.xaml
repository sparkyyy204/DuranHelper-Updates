<UserControl x:Class="FSB_helper_C__.ConfigBaseView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="650" d:DesignWidth="850" Background="Transparent"
             TextOptions.TextFormattingMode="Ideal" TextOptions.TextRenderingMode="ClearType">
    
    <Grid>
    <Grid Margin="30,20,10,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <!-- Headers -->
        <Grid Grid.Row="0" Margin="0,0,0,15">
            <StackPanel HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,-10,0,0">
                <TextBlock Text="БАЗА КОНФИГУРАЦИЙ" Foreground="{DynamicResource GoldBrush}" FontFamily="Segoe UI" FontWeight="Bold" FontSize="24"/>
                <TextBlock Text="УСТАНОВКА ГОТОВЫХ КОНФИГУРАЦИЙ И БАЗ ДАННЫХ ДЛЯ ВАШЕГО СЕРВЕРА" Foreground="{DynamicResource GrayBrush}" Opacity="0.8" FontFamily="Segoe UI" FontWeight="Bold" FontSize="12" Margin="0,0,0,0"/>
            </StackPanel>
            
            <!-- Актуальность базы Badge -->
            <StackPanel HorizontalAlignment="Right" VerticalAlignment="Top" Orientation="Horizontal" Margin="0,5,10,0">
                <TextBlock Text="Актуальность базы: " Foreground="{DynamicResource GrayBrush}" FontFamily="Segoe UI" FontSize="13" FontWeight="SemiBold" Opacity="0.7"/>
                <TextBlock Text="10.06.2026" Foreground="{DynamicResource GoldBrush}" FontFamily="Segoe UI" FontSize="13" FontWeight="Bold"/>
            </StackPanel>
        </Grid>

        <!-- Filters Grid -->
        <Grid Grid.Row="1" Margin="0,0,0,15" HorizontalAlignment="Left" Width="830">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="180"/>
                <ColumnDefinition Width="15"/>
                <ColumnDefinition Width="180"/>
                <ColumnDefinition Width="15"/>
                <ColumnDefinition Width="440"/>
            </Grid.ColumnDefinitions>

            <!-- Server Filter -->
            <Border Grid.Column="0" Height="36" CornerRadius="6" Background="{DynamicResource DeepBgBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1">
                <ComboBox x:Name="cmbServer" MaxDropDownHeight="210" Style="{DynamicResource DarkCombo}" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource TextBrush}" FontFamily="Segoe UI" FontSize="12" FontWeight="Bold" Margin="0,0"/>
            </Border>

            <!-- Category Filter -->
            <Border Grid.Column="2" Height="36" CornerRadius="6" Background="{DynamicResource DeepBgBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1">
                <ComboBox x:Name="cmbCategory" MaxDropDownHeight="210" Style="{DynamicResource DarkCombo}" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource TextBrush}" FontFamily="Segoe UI" FontSize="12" FontWeight="Bold" Margin="0,0"/>
            </Border>

            <!-- Search -->
            <Border Grid.Column="4" Height="36" CornerRadius="6" Background="{DynamicResource BgBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1.5">
                <Grid>
                    <TextBlock Text="Поиск по названию или автору..." Foreground="{DynamicResource GrayBrush}" FontFamily="Segoe UI" FontSize="12" VerticalAlignment="Center" Margin="35,0,0,0" IsHitTestVisible="False" x:Name="txtSearchHint"/>
                    <TextBox x:Name="txtSearch" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource TextBrush}" FontFamily="Segoe UI" FontSize="12" VerticalContentAlignment="Center" Margin="30,0,5,0" TextChanged="txtSearch_TextChanged"/>
                    <!-- Search Icon (magnifying glass) -->
                    <Canvas Width="20" Height="20" Margin="10,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Left" IsHitTestVisible="False">
                        <Ellipse Canvas.Left="5" Canvas.Top="5" Width="10" Height="10" Stroke="{DynamicResource GrayBrush}" StrokeThickness="2" Fill="Transparent"/>
                        <Line X1="13" Y1="13" X2="18" Y2="18" Stroke="{DynamicResource GrayBrush}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                    </Canvas>
                </Grid>
            </Border>
        </Grid>



        <!-- Error View -->
        <Border Grid.Row="2" x:Name="ErrorView" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed" Background="{DynamicResource SideBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="12" Padding="40,30" Margin="0,-40,0,0" Panel.ZIndex="5">
            <StackPanel>
                <Path Data="M12,2C6.48,2 2,6.48 2,12s4.48,10 10,10 10,-4.48 10,-10S17.52,2 12,2z M13,17h-2v-2h2V17z M13,13h-2V7h2V13z" Fill="{DynamicResource RedBrush}" Width="48" Height="48" Stretch="Uniform" HorizontalAlignment="Center" Margin="0,0,0,15"/>
                <TextBlock Text="БАЗА КОНФИГУРАЦИЙ НЕДОСТУПНА" Foreground="{DynamicResource RedBrush}" FontFamily="Segoe UI" FontWeight="Bold" FontSize="18" HorizontalAlignment="Center"/>
                <TextBlock x:Name="txtErrorMsg" Text="Не удалось выполнить загрузку каталога." Foreground="{DynamicResource GrayBrush}" FontFamily="Segoe UI" FontSize="13" HorizontalAlignment="Center" Margin="0,10,0,25" TextAlignment="Center" MaxWidth="250" TextWrapping="Wrap"/>
                
                <Button Content="ПОВТОРИТЬ ЗАГРУЗКУ" Width="200" Height="40" Click="Retry_Click" Cursor="Hand">
                    <Button.Template><ControlTemplate TargetType="Button"><Border x:Name="bg" Background="#1f6feb" CornerRadius="6"><TextBlock Text="{TemplateBinding Content}" Foreground="{DynamicResource TextBrush}" FontFamily="Segoe UI" FontWeight="Bold" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bg" Property="Background" Value="#388bfd"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Button.Template>
                </Button>
            </StackPanel>
        </Border>

                <!-- Empty State View -->
        <Border Grid.Row="2" x:Name="EmptyStateView" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed" Padding="40" Margin="0,-40,0,0">
            <StackPanel>
                <Grid Width="70" Height="70" HorizontalAlignment="Center" Margin="0,0,0,15">
                    <Ellipse x:Name="EmptyStateIconBg" Fill="{DynamicResource GoldBrush}" Opacity="0.08"/>
                    
                    <!-- Search Icon (Category Empty) -->
                    <Path x:Name="EmptyStateIconSearch" Visibility="Visible" Data="M15.5 14h-.79l-.28-.27C15.41 12.59 16 11.11 16 9.5 16 5.91 13.09 3 9.5 3S3 5.91 3 9.5 5.91 16 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z" Fill="{DynamicResource GoldBrush}" Width="24" Height="24" Stretch="Uniform" Opacity="0.6"/>
                    
                    <!-- Not Found Icon (Crossed/Gray) -->
                    <Path x:Name="EmptyStateIconNotFound" Visibility="Collapsed" Data="M15.5 14h-.79l-.28-.27C15.41 12.59 16 11.11 16 9.5 16 5.91 13.09 3 9.5 3S3 5.91 3 9.5 5.91 16 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z" Fill="{DynamicResource GrayBrush}" Width="24" Height="24" Stretch="Uniform" Opacity="0.6"/>
                    <!-- Strike-through line for 'not found' -->
                    <Line x:Name="EmptyStateIconStrike" Visibility="Collapsed" X1="20" Y1="20" X2="50" Y2="50" Stroke="{DynamicResource GrayBrush}" StrokeThickness="3" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Opacity="0.6"/>
                </Grid>
                
                <TextBlock x:Name="EmptyStateTitle" Text="ДАННАЯ КАТЕГОРИЯ ПУСТА" Foreground="{DynamicResource GoldBrush}" FontFamily="Segoe UI" FontWeight="Bold" FontSize="14" HorizontalAlignment="Center" Opacity="0.6"/>
                <TextBlock x:Name="EmptyStateDesc" Text="Конфигураций с такими параметрами не найдено." Foreground="{DynamicResource GrayBrush}" FontFamily="Segoe UI" FontSize="12" HorizontalAlignment="Center" Margin="0,8,0,0" TextAlignment="Center" Opacity="0.4"/>
            </StackPanel>
        </Border>
        <!-- Items Viewer (Virtualizing ListBox) -->
        <ListBox x:Name="icCloudList" Grid.Row="2" Background="Transparent" BorderThickness="0" Margin="0,0,-10,0" Padding="0,0,10,0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Visible" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" VirtualizingPanel.ScrollUnit="Pixel">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Padding" Value="0"/>
                    <Setter Property="Margin" Value="0"/>
                    <Setter Property="BorderThickness" Value="0"/>
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <ContentPresenter/>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <VirtualizingStackPanel Orientation="Vertical"/>
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border Focusable="False" Margin="0,0,0,12" Background="{DynamicResource SideBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="10" ClipToBounds="True">
                        <Grid Margin="15">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/> <!-- Icon -->
                                <ColumnDefinition Width="*"/>    <!-- Text -->
                                <ColumnDefinition Width="Auto"/> <!-- Actions -->
                            </Grid.ColumnDefinitions>

                            <!-- Icon Box -->
                            <Grid Grid.Column="0" VerticalAlignment="Top" Margin="0,0,20,0">
                                <Border x:Name="IconBg" Width="40" Height="40" CornerRadius="8" Background="#1f6feb" Opacity="0.1"/>
                                <Canvas Width="40" Height="40" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <!-- Profile Icon (Blue) -->
                                    <Canvas x:Name="IconProfile" Visibility="Visible">
                                        <Path Data="M 20 23 A 10 10 0 1 1 20 23 M 20 13 A 6 6 0 1 0 20 1 A 6 6 0 1 0 20 13 M 8 29 C 8 19 32 19 32 29" Stroke="#1f6feb" StrokeThickness="2.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Fill="Transparent"/>
                                    </Canvas>

                                    <!-- Laws Icon (Gold) -->
                                    <Canvas x:Name="IconLaws" Visibility="Collapsed">
                                        <Path Data="M 20 0 L 20 30 M 5 0 L 35 0 M 5 0 L 0 13 L 10 13 Z M 35 0 L 30 13 L 40 13 Z M 10 30 L 30 30" Stroke="{DynamicResource GoldBrush}" StrokeThickness="2" StrokeLineJoin="Round" Fill="Transparent"/>
                                    </Canvas>

                                    <!-- Fines Icon (Green) -->
                                    <Canvas x:Name="IconFines" Visibility="Collapsed">
                                        <Rectangle Canvas.Left="8" Canvas.Top="3" Width="24" Height="28" RadiusX="4" RadiusY="4" Fill="Transparent" Stroke="#2ea043" StrokeThickness="2"/>
                                        <Line X1="13" Y1="9" X2="27" Y2="9" Stroke="#2ea043" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                        <Ellipse Canvas.Left="12.5" Canvas.Top="15.5" Width="3" Height="3" Fill="#2ea043"/>
                                        <Ellipse Canvas.Left="18.5" Canvas.Top="15.5" Width="3" Height="3" Fill="#2ea043"/>
                                        <Ellipse Canvas.Left="24.5" Canvas.Top="15.5" Width="3" Height="3" Fill="#2ea043"/>
                                        <Ellipse Canvas.Left="12.5" Canvas.Top="21.5" Width="3" Height="3" Fill="#2ea043"/>
                                        <Ellipse Canvas.Left="18.5" Canvas.Top="21.5" Width="3" Height="3" Fill="#2ea043"/>
                                        <Ellipse Canvas.Left="24.5" Canvas.Top="21.5" Width="3" Height="3" Fill="#2ea043"/>
                                    </Canvas>

                                    <!-- Binds Icon (Purple) -->
                                    <Canvas x:Name="IconBinds" Visibility="Collapsed">
                                        <Rectangle Canvas.Left="5" Canvas.Top="7" Width="30" Height="20" RadiusX="4" RadiusY="4" Fill="Transparent" Stroke="#8957e5" StrokeThickness="2"/>
                                        <Line X1="10" Y1="21" X2="30" Y2="21" Stroke="#8957e5" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                        <Ellipse Canvas.Left="9.5" Canvas.Top="11.5" Width="3" Height="3" Fill="#8957e5"/>
                                        <Ellipse Canvas.Left="18.5" Canvas.Top="11.5" Width="3" Height="3" Fill="#8957e5"/>
                                        <Ellipse Canvas.Left="27.5" Canvas.Top="11.5" Width="3" Height="3" Fill="#8957e5"/>
                                    </Canvas>
                                    
                                    <!-- Patrols Icon (Orange) -->
                                    <Canvas x:Name="IconPatrols" Visibility="Collapsed">
                                        <Line X1="16" Y1="14" X2="16" Y2="6" Stroke="#ffa657" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                        <Line X1="24" Y1="14" X2="24" Y2="10" Stroke="#ffa657" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                        <Path Data="M 12 14 H 28 A 2 2 0 0 1 30 16 V 34 A 2 2 0 0 1 28 36 H 12 A 2 2 0 0 1 10 34 V 16 A 2 2 0 0 1 12 14 Z" Stroke="#ffa657" StrokeThickness="2" Fill="Transparent"/>
                                        <Line X1="16" Y1="22" X2="24" Y2="22" Stroke="#ffa657" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                        <Line X1="16" Y1="26" X2="24" Y2="26" Stroke="#ffa657" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                        <Line X1="16" Y1="30" X2="24" Y2="30" Stroke="#ffa657" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                    </Canvas>
                                </Canvas>
                            </Grid>

                            <!-- Content Texts -->
                            <StackPanel Grid.Column="1" Margin="0,0,20,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Title}" Foreground="{DynamicResource TextBrush}" FontFamily="Segoe UI" FontWeight="Bold" FontSize="15" TextWrapping="Wrap" Margin="0,0,0,4"/>
                                <TextBlock Text="{Binding Description}" Foreground="{DynamicResource GrayBrush}" FontFamily="Segoe UI" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,6"/>
                                
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Автор: " Foreground="{DynamicResource GrayBrush}" FontFamily="Segoe UI" FontSize="11"/>
                                    <TextBlock Text="{Binding Author}" Foreground="{DynamicResource TextBrush}" FontFamily="Segoe UI" FontSize="11"/>
                                </StackPanel>
                            </StackPanel>

                            <!-- Actions & Badges -->
                            <StackPanel Grid.Column="2" VerticalAlignment="Center" Width="130">
                                <Border x:Name="ServerBg" Background="{Binding BadgeBgBrush}" CornerRadius="6" Padding="6,4" HorizontalAlignment="Right" Margin="0,0,0,10">
                                    <TextBlock x:Name="ServerText" Text="{Binding Server}" Foreground="{Binding BadgeTextBrush}" FontFamily="Segoe UI" FontWeight="Bold" FontSize="11"/>
                                </Border>
                                
                                <Border Focusable="False" x:Name="BtnInstall" Height="30" Cursor="Hand" Background="#1A1f6feb" BorderBrush="#1f6feb" BorderThickness="1" CornerRadius="6" MouseLeftButtonDown="BtnInstall_Click" Tag="{Binding}">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Path x:Name="BtnIcon" Data="M19 9h-4V3H9v6H5l7 7 7-7zM5 18v2h14v-2H5z" Fill="#1f6feb" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0"/>
                                        <TextBlock x:Name="BtnInstallText" Text="УСТАНОВИТЬ" Foreground="#1f6feb" FontFamily="Segoe UI" FontWeight="Bold" FontSize="11" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <DataTemplate.Triggers>
                        <!-- Type Colors -->
                        <DataTrigger Binding="{Binding Type}" Value="fines">
                            <Setter TargetName="IconProfile" Property="Visibility" Value="Collapsed"/>
                            <Setter TargetName="IconFines" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="IconBg" Property="Background" Value="#2ea043"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Type}" Value="laws">
                            <Setter TargetName="IconProfile" Property="Visibility" Value="Collapsed"/>
                            <Setter TargetName="IconLaws" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="IconBg" Property="Background" Value="{DynamicResource GoldBrush}"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Type}" Value="binds">
                            <Setter TargetName="IconProfile" Property="Visibility" Value="Collapsed"/>
                            <Setter TargetName="IconBinds" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="IconBg" Property="Background" Value="#8957e5"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Type}" Value="patrols">
                            <Setter TargetName="IconProfile" Property="Visibility" Value="Collapsed"/>
                            <Setter TargetName="IconPatrols" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="IconBg" Property="Background" Value="#ffa657"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Type}" Value="profile">
                            <Setter TargetName="IconProfile" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="IconBg" Property="Background" Value="#1f6feb"/>
                        </DataTrigger>

                        <!-- Installed State -->
                        <DataTrigger Binding="{Binding IsInstalled}" Value="True">
                            <Setter TargetName="BtnInstall" Property="Background" Value="#1Af85149"/>
                            <Setter TargetName="BtnInstall" Property="BorderBrush" Value="#f85149"/>
                            <Setter TargetName="BtnInstall" Property="Cursor" Value="Hand"/>
                            <Setter TargetName="BtnInstallText" Property="Text" Value="УДAЛИТЬ"/>
                            <Setter TargetName="BtnInstallText" Property="Foreground" Value="#f85149"/>
                            <Setter TargetName="BtnIcon" Property="Fill" Value="#f85149"/>
                            <Setter TargetName="BtnIcon" Property="Data" Value="M6 19c0 1.1.9 2 2 2h8c1.1 0 2-.9 2-2V7H6v12zM19 4h-3.5l-1-1h-5l-1 1H5v2h14V4z"/>
                        </DataTrigger>
                    </DataTemplate.Triggers>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>

    <!-- Loading Overlay (Visible during fetch) -->
    <Border x:Name="LoadingOverlay" Background="{DynamicResource BgBrush}" Opacity="0.95" Panel.ZIndex="10" Visibility="Collapsed" CornerRadius="0" Margin="0">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
            <Grid Width="100" Height="100" HorizontalAlignment="Center">
                <Ellipse Fill="{DynamicResource GoldBrush}" Opacity="0.1" Width="80" Height="80" x:Name="pulseRing1" RenderTransformOrigin="0.5,0.5">
                    <Ellipse.RenderTransform><ScaleTransform ScaleX="1" ScaleY="1"/></Ellipse.RenderTransform>
                </Ellipse>
                <Ellipse Fill="{DynamicResource GoldBrush}" Opacity="0.2" Width="60" Height="60" x:Name="pulseRing2" RenderTransformOrigin="0.5,0.5">
                    <Ellipse.RenderTransform><ScaleTransform ScaleX="1" ScaleY="1"/></Ellipse.RenderTransform>
                </Ellipse>
                <Path Data="M19.35 10.04C18.67 6.59 15.64 4 12 4 9.11 4 6.6 5.64 5.35 8.04 2.34 8.36 0 10.91 0 14c0 3.31 2.69 6 6 6h13c2.76 0 5-2.24 5-5 0-2.64-2.05-4.78-4.65-4.96z" Fill="{DynamicResource GoldBrush}" Width="40" Height="28" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Grid>
            <TextBlock x:Name="txtLoadingTitle" Text="ПОДКЛЮЧЕНИЕ К БАЗЕ КОНФИГУРАЦИЙ" Foreground="{DynamicResource GoldBrush}" FontFamily="Segoe UI" FontWeight="Bold" FontSize="16" HorizontalAlignment="Center" Margin="0,20,0,5"/>
            <TextBlock x:Name="txtLoadingDesc" Text="Синхронизация каталога с сервером..." Foreground="{DynamicResource GrayBrush}" FontFamily="Segoe UI" FontSize="13" HorizontalAlignment="Center" Opacity="0.8"/>
        </StackPanel>
        <Border.Triggers>
            <EventTrigger RoutedEvent="Loaded">
                <BeginStoryboard>
                    <Storyboard RepeatBehavior="Forever">
                        <DoubleAnimation Storyboard.TargetName="pulseRing1" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" From="1" To="1.4" Duration="0:0:1.5" AutoReverse="True"/>
                        <DoubleAnimation Storyboard.TargetName="pulseRing1" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" From="1" To="1.4" Duration="0:0:1.5" AutoReverse="True"/>
                        <DoubleAnimation Storyboard.TargetName="pulseRing1" Storyboard.TargetProperty="Opacity" From="0.1" To="0" Duration="0:0:1.5" AutoReverse="True"/>
                        <DoubleAnimation Storyboard.TargetName="pulseRing2" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" From="1" To="1.2" Duration="0:0:1.5" AutoReverse="True"/>
                        <DoubleAnimation Storyboard.TargetName="pulseRing2" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" From="1" To="1.2" Duration="0:0:1.5" AutoReverse="True"/>
                        <DoubleAnimation Storyboard.TargetName="pulseRing2" Storyboard.TargetProperty="Opacity" From="0.2" To="0.05" Duration="0:0:1.5" AutoReverse="True"/>
                    </Storyboard>
                </BeginStoryboard>
            </EventTrigger>
        </Border.Triggers>
    </Border>

    <!-- Warning Overlay -->
    <Grid x:Name="WarningOverlay" Panel.ZIndex="1000">
        <Border Background="{DynamicResource BgBrush}" Opacity="0.9"/>
        <Border HorizontalAlignment="Center" VerticalAlignment="Center" Width="600" Background="{DynamicResource DeepBgBrush}" BorderBrush="{DynamicResource GoldBrush}" BorderThickness="1.5" CornerRadius="12" Padding="30">
            <StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,15">
                    <TextBlock Text="&#xE814;" FontFamily="Segoe MDL2 Assets" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource GoldBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock Text="ВНИМАНИЕ: АКТУАЛЬНОСТЬ ЗАКОНОВ" FontFamily="Segoe UI" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource GoldBrush}" VerticalAlignment="Center"/>
                </StackPanel>
                
                <TextBlock Foreground="{DynamicResource TextBrush}" FontSize="13" TextWrapping="Wrap" LineHeight="20">
                    <Run Text="В этой вкладке вы можете скачать готовый текст закона, а также наборы биндов."/><LineBreak/><LineBreak/>
                    <Run Text="ВАЖНОЕ ЗАМЕЧАНИЕ:" FontWeight="Bold" Foreground="#eb5b34"/> Законы и уставы могут меняться в любой день и время администрацией вашего сервера. Поэтому <Run Text="всегда проверяйте корректность закона после установки." FontWeight="Bold"/> Текст именно вашего сервера может быть устаревшим, если администрация скрипта пропустит какое-либо обновление закона.<LineBreak/><LineBreak/>
                    <Run Text="Ответственность за любые несостыковки с актуальной базой законов вашего сервера администрация проекта DURAN HELPER на себя не берет." Foreground="{DynamicResource GrayBrush}"/>
                </TextBlock>
                
                <Border BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0" Margin="0,20,0,20"/>
                
                <CheckBox x:Name="cbAcceptWarning" Content="Я ПРОЧИТАЛ И СОГЛАСЕН С УСЛОВИЯМИ" Foreground="{DynamicResource TextBrush}" FontFamily="Segoe UI" FontSize="13" FontWeight="Bold" HorizontalAlignment="Center" Checked="cbAcceptWarning_Checked" Unchecked="cbAcceptWarning_Checked">
                    <CheckBox.Template>
                        <ControlTemplate TargetType="CheckBox">
                            <StackPanel Orientation="Horizontal" Background="Transparent" Cursor="Hand">
                                <Border x:Name="chkBox" Width="22" Height="22" CornerRadius="4" BorderThickness="1.5" BorderBrush="{DynamicResource GoldBrush}" Background="{DynamicResource DeepBgBrush}" VerticalAlignment="Center">
                                    <Path x:Name="checkMark" Visibility="Collapsed" Data="M 4,11 L 9,16 L 18,5" Stroke="{DynamicResource GoldBrush}" StrokeThickness="2.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Stretch="None" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}" FontFamily="{TemplateBinding FontFamily}" FontSize="{TemplateBinding FontSize}" FontWeight="{TemplateBinding FontWeight}" VerticalAlignment="Center" Margin="12,0,0,0"/>
                            </StackPanel>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="checkMark" Property="Visibility" Value="Visible"/>
                                    <Setter TargetName="chkBox" Property="Background" Value="#102520"/>
                                    <Setter TargetName="chkBox" Property="BorderBrush" Value="{DynamicResource GoldBrush}"/>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="chkBox" Property="Background" Value="#1AFFFFFF"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </CheckBox.Template>
                </CheckBox>
                
                <Button x:Name="btnAcceptWarning" Content="ПРОДОЛЖИТЬ" IsEnabled="False" Width="180" Height="45" Margin="0,25,0,0" BorderThickness="1.5" FontFamily="Segoe UI" FontSize="14" FontWeight="Black" Click="btnAcceptWarning_Click">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource FlatBtn}">
                            <Setter Property="Background" Value="{DynamicResource DeepBgBrush}"/>
                            <Setter Property="Foreground" Value="{DynamicResource GrayBrush}"/>
                            <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}"/>
                            <Setter Property="Opacity" Value="0.6"/>
                            <Style.Triggers>
                                <Trigger Property="IsEnabled" Value="True">
                                    <Setter Property="Foreground" Value="{DynamicResource GoldBrush}"/>
                                    <Setter Property="BorderBrush" Value="{DynamicResource GoldBrush}"/>
                                    <Setter Property="Opacity" Value="1.0"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</Grid>
</UserControl>

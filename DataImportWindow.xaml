<Window x:Class="FSB_helper_C__.DataImportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ИМПОРТ ДАННЫХ В СИСТЕМУ" Height="420" Width="400"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" ResizeMode="NoResize"
        TextOptions.TextFormattingMode="Ideal" TextOptions.TextRenderingMode="ClearType">
    
    <Grid Margin="15" VerticalAlignment="Center" HorizontalAlignment="Center">
        <!-- Shadow Layer -->
        <Border Background="{DynamicResource BgBrush}" CornerRadius="14">
            
        </Border>
        
        <!-- Content Layer -->
        <Border Width="360" Background="{DynamicResource BgBrush}" CornerRadius="14" BorderBrush="{DynamicResource GoldBrush}" BorderThickness="2" UseLayoutRounding="True" SnapsToDevicePixels="True">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="45"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Header bar -->
                <Border Background="{DynamicResource SideBrush}" CornerRadius="12,12,0,0">
                    <Grid Margin="20,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="I" FontFamily="Consolas" Foreground="{DynamicResource GoldBrush}" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center" FontWeight="Bold"/>
                            <TextBlock Text="ИМПОРТ ДАННЫХ В СИСТЕМУ" Foreground="{DynamicResource TextBrush}" FontSize="13" FontWeight="Black" FontFamily="Segoe UI" VerticalAlignment="Center"/>
                        </StackPanel>
                        <Button Style="{StaticResource ModalCloseBtn}" Click="Close_Click"/>
                    </Grid>
                </Border>
                <Border Grid.Row="0" Height="1" VerticalAlignment="Bottom" Background="#30363d"/>

                <!-- Content -->
                <StackPanel Grid.Row="1" Margin="20,15,20,20">
                    <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource GrayBrush}" FontSize="11" FontFamily="Segoe UI" Margin="0,0,0,12">Выберите тип файла, который вы хотите загрузить. Текущие данные в выбранной категории будут перезаписаны.</TextBlock>

                    <!-- 1. Profile -->
                    <Button Height="52" Cursor="Hand" Click="ImportProfile_Click" Margin="0,0,0,8">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="bd" Background="{DynamicResource DeepBgBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1.5" CornerRadius="8" Padding="12,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="36"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <Border Width="26" Height="26" CornerRadius="13" Background="{DynamicResource GoldBrushTransparent}">
                                            <TextBlock Text="P" Foreground="{DynamicResource GoldBrush}" FontFamily="Consolas" FontSize="13" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0,0,0">
                                            <TextBlock Text="ПРОФИЛЬ ЦЕЛИКОМ" Foreground="{DynamicResource TextBrush}" FontSize="13" FontWeight="Bold" FontFamily="Segoe UI"/>
                                            <TextBlock Text="Файл (.duran). Загрузит бинды, законы и настройки." Foreground="{DynamicResource GrayBrush}" FontSize="10" FontFamily="Segoe UI" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="bd" Property="Background" Value="{DynamicResource SideBrush}"/>
                                        <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource GoldBrush}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <!-- 2. Laws only -->
                    <Button Height="52" Cursor="Hand" Click="ImportLaws_Click" Margin="0,0,0,8">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="bd" Background="{DynamicResource DeepBgBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1.5" CornerRadius="8" Padding="12,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="36"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <Border Width="26" Height="26" CornerRadius="13" Background="{DynamicResource GoldBrushTransparent}">
                                            <TextBlock Text="L" Foreground="{DynamicResource GoldBrush}" FontFamily="Consolas" FontSize="13" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0,0,0">
                                            <TextBlock Text="ТОЛЬКО БАЗА ЗАКОНОВ" Foreground="{DynamicResource TextBrush}" FontSize="13" FontWeight="Bold" FontFamily="Segoe UI"/>
                                            <TextBlock Text="Файл (.json). Загрузит только разделы УК, КоАП и т.д." Foreground="{DynamicResource GrayBrush}" FontSize="10" FontFamily="Segoe UI" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="bd" Property="Background" Value="{DynamicResource SideBrush}"/>
                                        <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource GoldBrush}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <!-- 3. Binds only -->
                    <Button Height="52" Cursor="Hand" Click="ImportBinds_Click" Margin="0,0,0,8">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="bd" Background="{DynamicResource DeepBgBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1.5" CornerRadius="8" Padding="12,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="36"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <Border Width="26" Height="26" CornerRadius="13" Background="{DynamicResource GoldBrushTransparent}">
                                            <TextBlock Text="B" Foreground="{DynamicResource GoldBrush}" FontFamily="Consolas" FontSize="13" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0,0,0">
                                            <TextBlock Text="ТОЛЬКО ИГРОВЫЕ БИНДЫ" Foreground="{DynamicResource TextBrush}" FontSize="13" FontWeight="Bold" FontFamily="Segoe UI"/>
                                            <TextBlock Text="Файл (.json). Загрузит бинды и группы." Foreground="{DynamicResource GrayBrush}" FontSize="10" FontFamily="Segoe UI" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="bd" Property="Background" Value="{DynamicResource SideBrush}"/>
                                        <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource GoldBrush}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <!-- 4. Fines only -->
                    <Button Height="52" Cursor="Hand" Click="ImportFines_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="bd" Background="{DynamicResource DeepBgBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1.5" CornerRadius="8" Padding="12,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="36"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <Border Width="26" Height="26" CornerRadius="13" Background="{DynamicResource GoldBrushTransparent}">
                                            <TextBlock Text="C" Foreground="{DynamicResource GoldBrush}" FontFamily="Consolas" FontSize="13" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0,0,0">
                                            <TextBlock Text="ТОЛЬКО БАЗА КАЛЬКУЛЯТОРА" Foreground="{DynamicResource TextBrush}" FontSize="13" FontWeight="Bold" FontFamily="Segoe UI"/>
                                            <TextBlock Text="Файл (.json). Загрузит категории штрафов и розыска для калькулятора." Foreground="{DynamicResource GrayBrush}" FontSize="10" FontFamily="Segoe UI" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="bd" Property="Background" Value="{DynamicResource SideBrush}"/>
                                        <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource GoldBrush}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
